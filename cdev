        if [[ -n ${2+x} ]]; then
          args['--branch']="$2"
          shift
          shift
        else
          printf "%s\n" "--branch requires an argument: --branch, -b GIT_BRANCH" >&2
          exit 1
        fi
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

  # :command.required_flags_filter
  if [[ -z ${args['--project_name']+x} ]]; then
    printf "missing required flag: --project_name, -p PROJECT_NAME\n" >&2
    exit 1
  fi

  # :command.needy_flags_filter
  # :flag.needs
  if [[ -n ${args['--branch']+x} ]] && [[ -z "${args[--source]:-}" ]]; then
    printf "%s\n" "--branch needs --source" >&2
    exit 1
  fi

}

# :command.parse_requirements
cdev_env_parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        cdev_env_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.command_filter
  action=${1:-}

  case $action in
    -*) ;;

    build)
      action="build"
      shift
      cdev_env_build_parse_requirements "$@"
      shift $#
      ;;

    start)
      action="start"
      shift
      cdev_env_start_parse_requirements "$@"
      shift $#
      ;;

    # :command.command_fallback
    "")
      cdev_env_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

