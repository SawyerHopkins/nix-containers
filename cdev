# :command.user_hooks
before_hook() {
  # src/before.sh
  echo "==[ Before Hook Called ]=="
  inspect_args

  if container_is_available; then
    CONTAINERIZATION_TOOL='container'
  else
    CONTAINERIZATION_TOOL=''
  fi

  if [[ -z "${CONTAINERIZATION_TOOL}" ]]; then
    echo "No supported containerization tool is available"
    exit 1
  fi
}

after_hook() {
  # src/after.sh
  echo "==[ After Hook Called ]=="
}

# :command.initialize
initialize() {
  declare -g version="0.1.0"
  set -e

  # src/initialize.sh

  # Set global variable containing the cdev script directory
  SCRIPT_DIR=$(dirname -- "$( readlink -f -- "$0"; )";)
}

# :command.run
run() {
  # :command.globals
  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"
  before_hook

  case "$action" in
    "project") cdev_project_command ;;
    "project create") cdev_project_create_command ;;
    "env") cdev_env_command ;;
    "env build") cdev_env_build_command ;;
    "env start") cdev_env_start_command ;;
  esac

  after_hook
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  # :command.start
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
fi
